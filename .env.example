# These are NOT read from this file in preview/production — they are set directly in the
# Expo Dashboard (project "gymtrack" -> Environment Variables) for the `preview` and
# `production` environments. This file only documents the variable names for local dev
# (copy to `.env.local` and fill in your own values if you ever run `npx expo start` locally).

EXPO_PUBLIC_KEYCLOAK_URL=
EXPO_PUBLIC_KEYCLOAK_REALM=gym-app
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=gymtrack-mobile

# Used only to auto-register the Expo Go "exp://" redirect URI on the gymtrack-mobile
# client before each login attempt (see src/core/auth/registerRedirectUri.ts) — avoids
# manually adding it to Keycloak every time. Accepted MVP-only risk: this secret is
# embedded in the public app bundle. See the plan file for details.
EXPO_PUBLIC_KEYCLOAK_AUTOMATION_CLIENT_ID=gymtrack-automation
EXPO_PUBLIC_KEYCLOAK_AUTOMATION_CLIENT_SECRET=

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
